{
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1400px"
        },
        "color": {
            "custom": false,
            "defaultPalette": false,
            "palette": [
                {
                    "color": "#2d5016",
                    "name": "Primary Green",
                    "slug": "primary-green"
                },
                {
                    "color": "#4a7c59",
                    "name": "Secondary Green",
                    "slug": "secondary-green"
                },
                {
                    "color": "#7fb069",
                    "name": "Light Green",
                    "slug": "light-green"
                },
                {
                    "color": "#a7c957",
                    "name": "Accent Green",
                    "slug": "accent-green"
                },
                {
                    "color": "#ffffff",
                    "name": "White",
                    "slug": "white"
                },
                {
                    "color": "#333333",
                    "name": "Dark Gray",
                    "slug": "dark-gray"
                },
                {
                    "color": "#f0f8e8",
                    "name": "Light Background",
                    "slug": "light-background"
                }
            ]
        },
        "typography": {
            "customFontSize": false,
            "fontStyle": true,
            "fontWeight": true,
            "letterSpacing": true,
            "lineHeight": true,
            "textDecoration": true,
            "textTransform": true,
            "fontSizes": [
                {
                    "size": "14px",
                    "slug": "small",
                    "name": "Small"
                },
                {
                    "size": "16px",
                    "slug": "regular",
                    "name": "Regular"
                },
                {
                    "size": "20px",
                    "slug": "medium",
                    "name": "Medium"
                },
                {
                    "size": "24px",
                    "slug": "large",
                    "name": "Large"
                },
                {
                    "size": "32px",
                    "slug": "extra-large",
                    "name": "Extra Large"
                },
                {
                    "size": "40px",
                    "slug": "huge",
                    "name": "Huge"
                }
            ],
            "fontFamilies": [
                {
                    "fontFamily": "'Segoe UI', Tahoma, Geneva, Verdana, sans-serif",
                    "name": "System Sans Serif",
                    "slug": "system-sans-serif"
                }
            ]
        },
        "spacing": {
            "customSpacingSize": true,
            "units": ["px", "em", "rem", "vh", "vw", "%"],
            "spacingSizes": [
                {
                    "size": "0.5rem",
                    "slug": "small",
                    "name": "Small"
                },
                {
                    "size": "1rem",
                    "slug": "medium",
                    "name": "Medium"
                },
                {
                    "size": "2rem",
                    "slug": "large",
                    "name": "Large"
                },
                {
                    "size": "3rem",
                    "slug": "x-large",
                    "name": "Extra Large"
                }
            ]
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "blocks": {
            "core/button": {
                "color": {
                    "palette": [
                        {
                            "color": "#2d5016",
                            "name": "Primary Green",
                            "slug": "primary-green"
                        },
                        {
                            "color": "#4a7c59",
                            "name": "Secondary Green",
                            "slug": "secondary-green"
                        },
                        {
                            "color": "#ffffff",
                            "name": "White",
                            "slug": "white"
                        }
                    ]
                },
                "typography": {
                    "fontSizes": [
                        {
                            "size": "16px",
                            "slug": "regular",
                            "name": "Regular"
                        },
                        {
                            "size": "18px",
                            "slug": "medium",
                            "name": "Medium"
                        },
                        {
                            "size": "20px",
                            "slug": "large",
                            "name": "Large"
                        }
                    ]
                }
            },
            "core/heading": {
                "color": {
                    "palette": [
                        {
                            "color": "#2d5016",
                            "name": "Primary Green",
                            "slug": "primary-green"
                        },
                        {
                            "color": "#4a7c59",
                            "name": "Secondary Green",
                            "slug": "secondary-green"
                        },
                        {
                            "color": "#333333",
                            "name": "Dark Gray",
                            "slug": "dark-gray"
                        }
                    ]
                }
            }
        }
    },
    "styles": {
        "color": {
            "background": "#ffffff",
            "text": "#333333"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system-sans-serif)",
            "fontSize": "var(--wp--preset--font-size--regular)",
            "lineHeight": "1.6"
        },
        "spacing": {
            "blockGap": "1.5rem"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "#4a7c59"
                },
                ":hover": {
                    "color": {
                        "text": "#2d5016"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "#2d5016",
                    "text": "#ffffff"
                },
                "border": {
                    "radius": "50px"
                },
                "spacing": {
                    "padding": {
                        "top": "1rem",
                        "right": "2rem",
                        "bottom": "1rem",
                        "left": "2rem"
                    }
                },
                "typography": {
                    "fontWeight": "bold"
                },
                ":hover": {
                    "color": {
                        "background": "#4a7c59"
                    }
                }
            },
            "h1": {
                "color": {
                    "text": "#2d5016"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--huge)",
                    "fontWeight": "bold",
                    "lineHeight": "1.2"
                }
            },
            "h2": {
                "color": {
                    "text": "#2d5016"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--extra-large)",
                    "fontWeight": "bold",
                    "lineHeight": "1.3"
                }
            },
            "h3": {
                "color": {
                    "text": "#4a7c59"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "600",
                    "lineHeight": "1.4"
                }
            }
        },
        "blocks": {
            "core/paragraph": {
                "spacing": {
                    "margin": {
                        "bottom": "1rem"
                    }
                }
            },
            "core/group": {
                "spacing": {
                    "padding": {
                        "top": "2rem",
                        "right": "2rem",
                        "bottom": "2rem",
                        "left": "2rem"
                    }
                }
            },
            "core/columns": {
                "spacing": {
                    "margin": {
                        "bottom": "2rem"
                    }
                }
            }
        }
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ],
    "customTemplates": [
        {
            "name": "front-page",
            "title": "Front Page",
            "postTypes": ["page"]
        },
        {
            "name": "single-testimonial",
            "title": "Single Testimonial",
            "postTypes": ["testimonial"]
        }
    ]
}